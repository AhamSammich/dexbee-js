{
  "name": "dexbee-js",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.16.0",
  "description": "A TypeScript IndexedDB ORM with SQL-like query builder interface",
  "author": "Andre Hammons <dev@ahammons.me>",
  "license": "MIT",
  "homepage": "https://github.com/ahamsammich/dexbee-js#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahamsammich/dexbee-js.git"
  },
  "bugs": {
    "url": "https://github.com/ahamsammich/dexbee-js/issues"
  },
  "keywords": [
    "indexeddb",
    "orm",
    "typescript",
    "database",
    "query-builder"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "dist/index.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "pnpm test && pnpm build",
    "prepack": "pnpm build",
    "version": "node scripts/sync-versions.cjs && git add -A",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch -m \"Release %s\"",
    "release:minor": "npm version minor -m \"Release %s\"",
    "release:major": "npm version major -m \"Release %s\"",
    "release:beta": "npm version prerelease --preid=beta && npm publish --tag beta",
    "release:alpha": "npm version prerelease --preid=alpha && npm publish --tag alpha",
    "release:dry-run": "npm publish --dry-run"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.36.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
