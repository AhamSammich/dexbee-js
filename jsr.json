{
  "name": "@dexbee/dexbee-js",
  "version": "0.3.0",
  "description": "A TypeScript IndexedDB ORM with SQL-like query builder interface",
  "license": "MIT",
  "keywords": [
    "indexeddb",
    "orm",
    "typescript",
    "database",
    "query-builder",
    "browser",
    "offline-first",
    "sql-like",
    "tree-shaking"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ]
  },
  "publish": {
    "exclude": [
      "node_modules",
      "dist",
      "tests",
      "docs",
      "examples",
      "packages",
      ".git",
      ".vscode",
      "*.log",
      ".env",
      "tsconfig.tsbuildinfo",
      "pnpm-lock.yaml"
    ]
  }
}
