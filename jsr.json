{
  "name": "@dexbee/dexbee-js",
  "version": "0.4.0",
  "description": "A TypeScript IndexedDB ORM with SQL-like query builder interface. Cross-runtime compatible (Browser, Node.js, Deno, Bun).",
  "license": "MIT",
  "keywords": [
    "indexeddb",
    "orm",
    "typescript",
    "database",
    "query-builder",
    "browser",
    "offline-first",
    "sql-like",
    "tree-shaking",
    "node",
    "deno",
    "bun",
    "testing",
    "cross-runtime"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ]
  },
  "runtime": {
    "browser": "stable",
    "node": "stable",
    "deno": "stable"
  },
  "publish": {
    "exclude": [
      "node_modules",
      "dist",
      "tests",
      "docs",
      "examples",
      "packages",
      ".git",
      ".vscode",
      "*.log",
      ".env",
      "tsconfig.tsbuildinfo",
      "pnpm-lock.yaml",
      "coverage",
      "scripts",
      ".github",
      ".prettier*",
      "*.config.js",
      "*.config.ts",
      "vitest.*.config.ts",
      "tsup.config.ts",
      "eslint.config.js",
      "CHANGELOG.md",
      "CLAUDE.md",
      "WARP.md",
      "*.test.ts",
      "*.test.js",
      "*.spec.ts",
      "*.spec.js"
    ]
  }
}
